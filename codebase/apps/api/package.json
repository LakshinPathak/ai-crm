{
  "name": "@ai-crm/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./create-app": "./src/create-app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "populate-demo": "tsx scripts/populate-demo.ts",
    "hubspot:seed": "tsx scripts/hubspot-seed.ts",
    "hubspot:sync": "tsx scripts/hubspot-sync.ts",
    "hubspot:test": "tsx scripts/hubspot-test.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@ai-crm/db": "workspace:*",
    "@ai-crm/events": "workspace:*",
    "@ai-crm/integrations-crm": "workspace:*",
    "@ai-crm/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
