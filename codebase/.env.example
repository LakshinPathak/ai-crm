# ─── Shared ─────────────────────────────────────────────
# Local: mongodb://localhost:27017/ai-crm
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-crm
MONGODB_URI=mongodb://localhost:27017/ai-crm
NODE_ENV=development

# ─── Auth (Google OAuth + JWT) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=7d
# 32+ char secret for AES-256-GCM OAuth token encryption (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=change-me-in-production-use-32-plus-chars

# ─── Web (apps/web) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SSE_URL=http://localhost:4000

# ─── API (apps/api) ───────────────────────────────────
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-in-prod

# ─── AI (Google Gemini) ───────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Integrations (optional — demo mode works without these) ─
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Optional comma-separated OAuth scopes (default includes chat:write, channels:read)
# SLACK_OAUTH_SCOPES=chat:write,commands,users:read,channels:read,groups:read
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# GOOGLE_CHAT_CLIENT_ID=  # optional; falls back to GOOGLE_CLIENT_ID
# GOOGLE_CHAT_CLIENT_SECRET=  # optional; falls back to GOOGLE_CLIENT_SECRET
# GONG_CLIENT_ID=
# GONG_CLIENT_SECRET=
# GONG_WEBHOOK_SECRET=  # fallback HMAC secret when connection has no settings.webhookSecret
# HUBSPOT_WEBHOOK_SECRET=
# HUBSPOT_WEBHOOK_PUBLIC_HOST=
# Fallback HMAC secret for CRM webhooks when connection.settings.webhookSecret is unset
# WEBHOOK_HMAC_SECRET=
